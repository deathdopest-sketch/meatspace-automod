# Copy to /etc/stumble-automod/<name>.env (chmod 600), then:
#   systemctl enable --now stumble-automod@<name>
# Use a dedicated StumbleChat account for the bot, made a mod in the room.

AUTOMOD_LOGIN_EMAIL=bot-account@example.com
# Quote the password if it contains '#'
AUTOMOD_LOGIN_PASS="replace_me"
AUTOMOD_BOT_NICK=Enforcer
AUTOMOD_ROOM=meatspace

# Each instance on the same server needs its own port
CDP_DEBUG_PORT=9223
